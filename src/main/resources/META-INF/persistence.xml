<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
    <persistence-unit name="persistence-unit" transaction-type="RESOURCE_LOCAL">
        <class>org.justiceleague.beans.Kategorie</class>
        <!-- ← anpassen an deinen tatsächlichen Klassennamen inkl. Package -->
        <class>org.commercetron.beans.Admin</class>
        <class>org.commercetron.beans.Bestellung</class>
        <class>org.commercetron.beans.Bewertung</class>
        <class>org.commercetron.beans.Kategorie</class>
        <class>org.commercetron.beans.Products</class>
        <class>org.commercetron.beans.User</class>
        <class>org.commercetron.beans.Warenkorb</class>
        <class>org.commercetron.beans.Wunschliste</class>
        <class>org.commercetron.beans.Zahlung</class>
        <properties>
            <!-- JDBC-Verbindung -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://127.0.0.1:5432/webShop"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <!--      <property name="jakarta.persistence.jdbc.password" value="Icheesse1"/>-->
            <property name="jakarta.persistence.jdbc.password" value="postgres"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <!-- Hibernate spezifisch -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
